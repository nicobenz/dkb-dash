{
	"name": "dkb-dash",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright install && playwright test",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "node --env-file-if-exists=.env scripts/migrate.js",
		"db:studio": "drizzle-kit studio",
		"start": "node scripts/migrate.js && node scripts/server.js"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource/fira-mono": "5.3.0",
		"@fontsource/fira-sans": "5.3.0",
		"@inlang/paraglide-js": "^2.18.2",
		"@inlang/plugin-m-function-matcher": "2.2.17",
		"@inlang/plugin-message-format": "4.4.5",
		"@lucide/svelte": "1.52.0",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/d3-scale": "4.0.9",
		"@types/d3-shape": "3.2.0",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^4.1.8",
		"d3-scale": "4.0.2",
		"d3-shape": "3.2.0",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"impeccable": "4.7.0",
		"layerchart": "2.5.2",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"drizzle-orm": "0.45.2",
		"postgres": "3.4.9"
	}
}
